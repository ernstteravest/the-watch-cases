# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these under Project → Settings → Environment Variables.

# Public URL of the site (used for canonical links and Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Stage 6)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=        # server only, never expose to the browser

# Stripe (Stage 7, test keys only until launch is approved)
# STRIPE_SECRET_KEY=                # server only
# STRIPE_WEBHOOK_SECRET=            # server only
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
