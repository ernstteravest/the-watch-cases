# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these under Project → Settings → Environment Variables.

# Public URL of the site (used for canonical links and Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (set automatically on Vercel by the Supabase integration)
# Either key naming works: anon/service_role or publishable/secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # or NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=            # or SUPABASE_SECRET_KEY; server only, never NEXT_PUBLIC_

# Stripe (payments). Off until both are set. Use TEST keys (sk_test_…) first.
# A live key (sk_live_…) is refused unless STRIPE_ALLOW_LIVE=true is set deliberately at launch.
# STRIPE_SECRET_KEY=                # server only
# STRIPE_WEBHOOK_SECRET=            # server only; endpoint: https://<site>/api/webhooks/stripe
# STRIPE_ALLOW_LIVE=false

# E-mail (order confirmations via Resend). Off until both are set; needs a verified domain.
# RESEND_API_KEY=                   # server only
# EMAIL_FROM="The Watch Cases <orders@thewatchcases.nl>"
